NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://example.ngrok-free.app

DB_HOST=localhost
DB_PORT=3306
DB_USER=drug_supply_user
DB_PASSWORD=change-me
DB_NAME=drug_supply_chain
DB_CONNECTION_LIMIT=10

REDIS_URL=
SESSION_TTL_SECONDS=604800

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=false

DEFAULT_FACILITY_ID=1
ALLOW_UNKNOWN_USERS=true
EXPIRY_ALERT_DAYS=90

ENABLE_CRON=false
REMINDER_CRON=0 8 * * *
CONSUMPTION_REMINDER_TEXT=Please submit today's medicine consumption report.

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TRUST_PROXY=false
LOG_LEVEL=info

# Prescription OCR: PP-OCRv6 Small persistent worker.
OCR_PYTHON_PATH=
OCR_TIMEOUT_MS=90000
OCR_STARTUP_TIMEOUT_MS=120000

# Optional Azure provider. Paddle remains the default unless explicitly selected.
PRESCRIPTION_OCR_PROVIDER=paddle
# Prescription extraction mode. Legacy is the default; Layout is opt-in for Phase 3 validation.
PRESCRIPTION_EXTRACTION_MODE=legacy
# Optional Azure Layout shadow analysis. Disabled by default and never affects the live prescription result.
PRESCRIPTION_LAYOUT_SHADOW_ENABLED=false
# Local-only detailed Layout extractor diagnostics. Never emits candidate details in production.
PRESCRIPTION_LAYOUT_DEBUG=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OCR_TIMEOUT_MS=45000
AZURE_OCR_POLL_INTERVAL_MS=1000
